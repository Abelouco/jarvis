{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS",
  "version": "0.1.32",
  "identifier": "com.jarvis.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "J.A.R.V.I.S.",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#04060b",
        "decorations": false,
        "shadow": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMDk2RTgyRUZEMjIzNDMKUldSREk5THZnbTRKVXpMOFJIa0d0c2IrajExdlNWemJOeWliMGR3SlZWOG9iN0JCNjdBRUpFaFAK",
      "endpoints": [
        "https://github.com/Abelouco/jarvis/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
