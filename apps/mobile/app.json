{
  "expo": {
    "name": "J.A.R.V.I.S",
    "slug": "jarvis",
    "scheme": "jarvis",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04060b",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "app.jarvis.pessoal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#04060b"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "defaultChannel": "avisos",
          "color": "#38e1cf"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class expo.modules.gl.** { *; }\n-keepclassmembers class * extends expo.modules.kotlin.views.ExpoView { <init>(...); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63dbb886-9144-4ba1-b977-b167bdd0bda4"
      }
    },
    "owner": "stoner031",
    "updates": {
      "url": "https://u.expo.dev/63dbb886-9144-4ba1-b977-b167bdd0bda4"
    },
    "ios": {}
  }
}
